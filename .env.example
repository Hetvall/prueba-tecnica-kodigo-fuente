# --- Base de datos ---
POSTGRES_USER=promociones
POSTGRES_PASSWORD=changeme
POSTGRES_DB=promociones
POSTGRES_PORT=5432

# Cadena de conexión usada por Prisma (backend). El host "db" es el nombre
# del servicio de PostgreSQL en docker-compose.
DATABASE_URL=postgresql://promociones:changeme@db:5432/promociones

# --- Backend ---
PORT=4000
NODE_ENV=production

# --- Frontend ---
# Puerto expuesto en el host para acceder a la app vía Nginx.
FRONTEND_PORT=8080
